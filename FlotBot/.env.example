# ==============================================================================
# FlotBot AI - Cross-Platform Endpoint Protection Configuration (.env.example)
# ==============================================================================

# -----------------------------------------------
# External Security Intelligence APIs (Primary Detection Authority)
# -----------------------------------------------

# VirusTotal API (File SHA-256 / URL / IP / Domain Reputation)
# Get a key at: https://www.virustotal.com/
VIRUSTOTAL_API_KEY=

# Google Safe Browsing API (Malicious & Phishing URL Detection)
# Get a key at: https://console.cloud.google.com/apis/credentials
GOOGLE_SAFE_BROWSING_API_KEY=

# Hybrid Analysis API (Falcon Sandbox Deep File Behavioral Escalation)
# Get a key at: https://www.hybrid-analysis.com/
HYBRID_ANALYSIS_API_KEY=

# -----------------------------------------------
# Gemini AI (Reasoning, Multi-Modal Vision & Explanation) — CLOUD AI
# -----------------------------------------------
# Get a free key at: https://aistudio.google.com/
# Gemini provides explanations & visual analysis; it is NOT the sole detection authority.
GEMINI_API_KEY=

# -----------------------------------------------
# AI Privacy Mode
# -----------------------------------------------
# When true: BOTH chat and analysis use Ollama (fully offline, zero cloud telemetry).
# When false: uses cloud APIs where configured.
AI_PRIVACY_MODE=false

# -----------------------------------------------
# Ollama (Threat / Process / Network Analysis) — LOCAL AI
# -----------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# -----------------------------------------------
# Monitoring & Telemetry Settings
# -----------------------------------------------
SCAN_INTERVAL=5000
SCREEN_SECURITY_MODE=MANUAL
LEARNING_MODE_HOURS=24
DEBUG=false
