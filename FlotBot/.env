# ==============================================================================
# FlotBot - Windows Endpoint Protection Configuration
# ==============================================================================

# -----------------------------------------------
# AI Privacy Mode
# -----------------------------------------------
# When true: BOTH chat and analysis use Ollama (fully offline, no cloud data).
# When false (default): chat/explain uses Gemini (cloud), analysis uses Ollama.
# Can also be toggled at runtime from the Admin Console without restart.
AI_PRIVACY_MODE=false

# -----------------------------------------------
# Gemini (Chat + Alert Explain) — CLOUD AI
# -----------------------------------------------
# Get a FREE API key at: https://aistudio.google.com/app/apikey
# Paste your key below starting with 'AIzaSy...' or leave blank to use Local Ollama.
GEMINI_API_KEY=AIzaSyCB2yrcSru0Ffe4mFp3JOPHI3Bm64qlBNM
GEMINI_MODEL=gemini-flash-latest

# -----------------------------------------------
# Ollama (Threat / Process / Network Analysis) — LOCAL AI
# -----------------------------------------------
# Install Ollama from: https://ollama.com
# Then run: ollama pull llama3.1
# Leave these at defaults if Ollama is running locally.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# -----------------------------------------------
# Monitoring Settings
# -----------------------------------------------
# Security scanning frequency in milliseconds
SCAN_INTERVAL=5000

# -----------------------------------------------
# Learning Mode
# -----------------------------------------------
# Hours for the initial baseline learning window (24 or 48 recommended).
LEARNING_MODE_HOURS=24

# Verbose logging to stdout
DEBUG=true


# Security Intelligence
VIRUSTOTAL_API_KEY=fd51e5c926fac07adb277e544aa7ceab760abe867dc94d964910f612236a3617
GOOGLE_SAFE_BROWSING_API_KEY=AIzaSyBGzx_pxIBFNs0uZleSnOsLiUac9J7SOXQ
HYBRID_ANALYSIS_API_KEY=zvq6w1of222f5c0ffmk1oq7yc1187318vm4i3zz33d35ad14q7bpn5u15523160b


